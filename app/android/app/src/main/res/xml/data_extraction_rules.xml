<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: 클라우드 백업과 기기 간 이전 모두에서 앱 데이터를 뺀다.
     즐겨찾기(저장한 곳)·고른 지역은 기기에만 둔다 (docs/decisions.md #19).
     allowBackup="false" 만으로는 일부 기기에서 기기 간 이전이 막히지 않는다
     (https://developer.android.com/identity/data/autobackup, 2026-11-04 확인). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
        <exclude domain="device_root" path="."/>
        <exclude domain="device_file" path="."/>
        <exclude domain="device_database" path="."/>
        <exclude domain="device_sharedpref" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
        <exclude domain="device_root" path="."/>
        <exclude domain="device_file" path="."/>
        <exclude domain="device_database" path="."/>
        <exclude domain="device_sharedpref" path="."/>
    </device-transfer>
</data-extraction-rules>
